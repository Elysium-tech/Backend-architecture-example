# =============================================================================
# Backend — Environment Variables
# Copie este arquivo para .env e preencha os valores
# =============================================================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# =============================================================================
# Database — Neon Postgres (vai substituir o SQLite local)
# =============================================================================
# 1. Crie um projeto em https://console.neon.tech (plano Free).
# 2. No dashboard: Connect -> copie a string POOLED (termina com
#    -pooler... ou usa o host com "pooler") e a string DIRECT.
# 3. Cole abaixo (SEM aspas extras) e NUNCA commite o .env real.
#
# POOLED (app em runtime: pgBouncer, aguenta muitas conexoes curtas):
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>.neon.tech/<dbname>?sslmode=require"
# DIRECT (migrations, pg_dump: conexao 1:1 sem pooler):
DIRECT_URL="postgresql://<user>:<password>@<direct-host>.neon.tech/<dbname>?sslmode=require"
#
# Branching: crie um branch por ambiente (dev/staging) ou por PR de
# preview; cada branch tem suas proprias URLs pooled/direct.
# SQLite local (legado, Fase 0): DATABASE_URL="file:./dev.db" sem DIRECT_URL.

# Auth
JWT_SECRET=change_me_to_a_strong_secret
SALT_ROUNDS=10

# Logging
LOG_PRETTY=true

# Realtime (opcional; sem ele o Socket.IO roda single-instance)
# REDIS_URL=redis://localhost:6379
